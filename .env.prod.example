# Copier en `.env.prod` sur le serveur et remplir. NE JAMAIS committer .env.prod.

# --- Adresse publique ---------------------------------------------------------
# Nom de domaine pointant vers le VPS (HTTPS automatique via Caddy)
SITE_ADDRESS=app.mondomaine.be
# URL complète, avec https:// et sans slash final. Doit correspondre à SITE_ADDRESS.
PUBLIC_URL=https://app.mondomaine.be

# --- Base de données ----------------------------------------------------------
POSTGRES_USER=projet66
POSTGRES_DB=projet66
# Utiliser des caractères alphanumériques uniquement (le mot de passe est inséré
# dans une URL de connexion). Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Better Auth --------------------------------------------------------------
# Secret de signature des sessions, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Frontend -----------------------------------------------------------------
# URL de l'API utilisée par le front (injectée au build). Laisser /api avec le
# reverse proxy Caddy fourni (même domaine).
EXPO_PUBLIC_API_URL=/api
