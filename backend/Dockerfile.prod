# Image de production du backend NestJS (multi-stage).
#
# - stage "build"     : toutes les dépendances (dont la CLI Prisma) + `nest build`.
#                       Ce stage sert aussi au conteneur one-shot `migrate`.
# - stage "prod-deps" : uniquement les dépendances de production.
# - stage "runtime"   : image finale légère, lance `node dist/main`.

FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-alpine AS prod-deps
WORKDIR /app
COPY package*.json .npmrc ./
RUN npm ci --omit=dev

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package*.json ./
USER node
EXPOSE 3000
CMD ["node", "dist/main"]
